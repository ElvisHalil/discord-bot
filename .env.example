# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here

# YouTube Data API Key (Used for live streams, music resolution, search)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Default Bot Profile (from src/config.py or src/config.example.py): research, chat
DEFAULT_PROFILE=research

# Bot Owner Discord User ID (Enables !mode command)
BOT_OWNER_ID=your_discord_user_id_here

# Optional: Last.fm API Key for music discovery
LASTFM_API_KEY=your_lastfm_api_key_here

# Optional: FreqBlog API Key for electronic music
FREQBLOG_API_KEY=your_freqblog_api_key_here

# Optional: The Odds API Key (https://the-odds-api.com/)
# Free tier gives 500 requests/month for live sports & esports betting odds.
# If omitted, the bot falls back to built-in web stealth scraping for odds automatically.
THE_ODDS_API_KEY=

# Optional: KashRock API Key for CS2 esports player props & recent map boxscores
KASHROCK_API_KEY=

# Optional: Brave Search API Key (Fallback web search provider)
BRAVE_API_KEY=

# Optional: Telegram Bot Bridge (Runs alongside Discord when ENABLE_TELEGRAM=true)
# Get your token by messaging /newbot to @BotFather on Telegram.
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
# Fail-Closed Security: Only numeric Telegram User IDs or Group Chat IDs listed below can use the bot.
# (Send a message to the bot while running to see your numeric user_id / chat_id printed in the console).
TELEGRAM_OWNER_ID=
TELEGRAM_ALLOWED_IDS=

# Optional: Override Bot Local Timezone (e.g., America/New_York, Europe/London, CET, PST)
# Leave blank to automatically use the host system's local timezone.
BOT_TIMEZONE=
