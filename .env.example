# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here

# YouTube Data API Key (Used for live streams, music resolution, search)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Default Bot Profile: research-qwen, research-gemma, chat, chappie
DEFAULT_PROFILE=research-qwen

# Bot Owner Discord User ID (Enables !mode command)
BOT_OWNER_ID=your_discord_user_id_here

# Optional: Last.fm API Key for music discovery
LASTFM_API_KEY=your_lastfm_api_key_here

# Optional: FreqBlog API Key for electronic music
FREQBLOG_API_KEY=your_freqblog_api_key_here

# Optional: The Odds API Key (https://the-odds-api.com/)
# Free tier gives 500 requests/month for live sports & esports betting odds.
# If omitted, the bot falls back to built-in web stealth scraping for odds automatically.
THE_ODDS_API_KEY=

